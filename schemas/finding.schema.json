{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.capybari.com/source-intelligence/0.1/finding.schema.json",
  "title": "Capybari Source Intelligence finding",
  "description": "The common finding model every capability converges on (Master Plan, Section 10). Evidence before opinion: each finding carries its evidence, confidence, source analyzer and rule.",
  "type": "object",
  "required": ["id", "dimension", "category", "title", "severity", "confidence", "source", "detected_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^CSI-[0-9a-f]{16}$|^[A-Za-z0-9_.:-]+$", "description": "Stable identifier; survives unrelated edits so baselines work." },
    "dimension": { "$ref": "#/$defs/dimension" },
    "category": { "type": "string", "minLength": 1, "description": "Finding type within the dimension, e.g. secret, vulnerability, missing-header." },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "severity": { "$ref": "#/$defs/severity" },
    "confidence": { "$ref": "#/$defs/confidence" },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "source": {
      "type": "object",
      "required": ["capability", "version"],
      "additionalProperties": false,
      "properties": {
        "capability": { "type": "string" },
        "version": { "type": "string" },
        "engine": { "type": "string", "description": "Reused open-source engine that produced the raw result, if any." },
        "engine_version": { "type": "string" }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "references": { "type": "array", "items": { "type": "string" } }
      }
    },
    "component": { "type": "string", "description": "Affected component (package, module, service or URL)." },
    "related": { "type": "array", "items": { "type": "string" } },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "technical": { "type": "string" }, "business": { "type": "string" } }
    },
    "remediation": {
      "type": "object",
      "required": ["summary", "automatable"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "automatable": { "type": "boolean" },
        "references": { "type": "array", "items": { "type": "string" } }
      }
    },
    "false_positive_guidance": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "detected_at": { "type": "string", "format": "date-time" },
    "baseline_state": { "enum": ["new", "existing"] }
  },
  "$defs": {
    "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "dimension": {
      "enum": ["identity", "structure", "dependencies", "security", "change-risk", "maintainability", "data", "interfaces", "operability", "evolution", "ai-signals"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "description": "Slash-separated path relative to the repository root." },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string" },
        "url": { "type": "string" },
        "snippet": { "type": "string", "description": "Relevant excerpt. Secrets are always redacted." },
        "detail": { "type": "string" }
      }
    }
  }
}
